// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  // 把passwordHash改成可选，因为oauth拿到的信息没有password
  passwordHash  String?
  image         String?
  profileComplete Boolean @default(false)
  accounts      Account[]
  // one-to-one relationship with user
  member        Member?
}

model Member {
  id                String    @id @default(cuid())
  userId            String    @unique
  name              String
  gender            String
  dateOfBirth       DateTime
  created           DateTime  @default(now())
  updated           DateTime  @default(now())
  description       String
  city              String
  country           String
  image             String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos            Photo[]
  sourceLikes       Like[]    @relation("source")
  targetLikes       Like[]    @relation("target")
  // 在member里添加消息记录
  senderMessages    Message[] @relation("sender")
  recipientMessages Message[] @relation("recipient")
}

model Photo {
  id       String  @id @default(cuid())
  url      String
  publicId String?

  // many-to-one relationship with Member
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// 多对多的关系
model Like {
  sourceUserId String
  sourceMember Member @relation("source", fields: [sourceUserId], references: [userId], onDelete: Cascade)

  targetUserId String
  targetMember Member @relation("target", fields: [targetUserId], references: [userId], onDelete: Cascade)

  // 两个id同时作为这个表格的primary key
  @@id([sourceUserId, targetUserId])
}

// 多对多关系传递消息，一个member可以给另一个member发送多条消息
model Message {
  id               String    @id @default(cuid())
  text             String
  created          DateTime  @default(now())
  senderId         String?
  recipientId      String?
  // onDelete这里设置成，当member删除的时候，recipient里的消息不会删除
  // 当onDelete设置成 SetNull，fields里的内容不能是required, 必须是optional:senderId, recipientId, sender, recipient
  sender           Member?   @relation("sender", fields: [senderId], references: [userId], onDelete: SetNull)
  recipient        Member?   @relation("recipient", fields: [recipientId], references: [userId], onDelete: SetNull)
  // 都信息的时间记录
  dateRead         DateTime?
  senderDeleted    Boolean   @default(false)
  recipientDeleted Boolean   @default(false)
}

// 重点: 记录一些账户token
model Token {
  id String @id @default(cuid())
  email String
  token String
  expires DateTime
  type TokenType

  @@unique([email, token])
}

enum TokenType {
  VERIFICATION
  PASSWORD_RESET
}
